# Secrets des Edge Functions. Ne JAMAIS commiter le vrai fichier.
# En production : supabase secrets set --env-file supabase/functions/.env
# (SUPABASE_URL et SUPABASE_SERVICE_ROLE_KEY sont injectés automatiquement par Supabase.)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Prix indicatifs en USD par million de tokens (pour api_usage.cost_estimate) : à vérifier sur la page de tarifs Anthropic
CLAUDE_PRICE_IN_PER_MTOK=3
CLAUDE_PRICE_OUT_PER_MTOK=15
# Origines autorisées (CORS), séparées par des virgules
ALLOWED_ORIGINS=http://localhost:5173,https://ton-site.netlify.app

# ElevenLabs (voix off)
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Coût estimé par 1000 caractères (USD) selon ton abonnement ; 0 = on suit seulement le nombre de caractères
ELEVENLABS_COST_PER_1K_CHARS=0

# SerpApi (recherche d'image inversée, moteur google_lens)
SERPAPI_KEY=
# Coût estimé par recherche (USD) selon ton forfait ; 0 = on suit seulement le nombre de recherches
SERPAPI_COST_PER_SEARCH=0

# Tâche planifiée de nettoyage (cron-cleanup) : génère une longue valeur aléatoire (ex. openssl rand -hex 32)
CRON_SECRET=
# SasPay (Mobile Money Afrique)
SASPAY_API_KEY=
SASPAY_WEBHOOK_SECRET=

# Chariow (paiement par carte) — à configurer quand le compte sera créé
CHARIOW_WEBHOOK_SECRET=
