# Variables du FRONT (publiques par nature : elles sont embarquées dans le JavaScript du site).
# Ne mets JAMAIS ici de clé secrète (Anthropic, ElevenLabs, SerpApi, SasPay, Chariow, service_role...).
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=
